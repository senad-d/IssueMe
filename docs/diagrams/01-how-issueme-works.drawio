<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="31.7.0">
  <diagram id="01-how-issueme-works" name="How IssueMe works">
    <mxGraphModel dx="1500" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1210" pageHeight="1280" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="How IssueMe works" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontColor=#0F172A;spacing=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1130" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="On-demand tools, not a background bot. GitHub is the source of truth; the local cache is optional." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1130" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;Ask for an issue workflow&lt;br&gt;Optional project skill" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Pi agent&lt;/b&gt;&lt;br&gt;Reads your request / skill&lt;br&gt;Chooses tools and exact targets" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="180" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="tools" value="&lt;b&gt;IssueMe extension&lt;/b&gt;&lt;br&gt;47 issueme_* tools + /issueme&lt;br&gt;Typed inputs; bounded outputs" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="180" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;Cached get_issue (no refresh)&lt;/b&gt;&lt;br&gt;Trust + config + repository checks&lt;br&gt;No token or network needed" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="330" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="runtime" value="&lt;b&gt;Remote-operation checks&lt;/b&gt;&lt;br&gt;Trusted project; config; repo; token&lt;br&gt;Creator scope + target identity&lt;br&gt;Open-state / permission policy" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="370" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;Optional local JSON cache&lt;/b&gt;&lt;br&gt;.pi/issues/&amp;lt;number&amp;gt;-&amp;lt;slug&amp;gt;.json&lt;br&gt;Open, in-scope issues only&lt;br&gt;Bodies + up to 100 comments" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="330" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;GitHub API clients&lt;/b&gt;&lt;br&gt;REST: issues, comments, taxonomy,&lt;br&gt;templates, dependencies, related links&lt;br&gt;GraphQL: boards, sub-issues,&lt;br&gt;development links, issue deletion" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="600" width="380" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;Result back to the agent → you&lt;/b&gt;&lt;br&gt;Inspect isError + details.result / status / needsSync&lt;br&gt;Report verified changes; reconcile partial outcomes" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="600" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="github" value="&lt;b&gt;GitHub • source of truth&lt;/b&gt;&lt;br&gt;Reads and explicit mutations&lt;br&gt;No automatic retry or rollback" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="890" width="380" height="140" as="geometry"/>
        </mxCell>
