        <mxCell id="note" value="&lt;b&gt;Safety boundary&lt;/b&gt;&lt;br&gt;Tokens stay out of config/cache/output. Requests and issue targets are repository-scoped.&lt;br&gt;Cache/config writes use safe paths and file-mutation queues; IssueMe mutations run sequentially.&lt;br&gt;No GitHub CLI, webhooks, listeners, or automatic issue changes from editing a cache file." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1100" width="1130" height="140" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
